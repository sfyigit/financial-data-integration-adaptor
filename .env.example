# =============================================================================
# FSec Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the .env file to version control.

# --- General ---
ENVIRONMENT=development
DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-random-64-char-string

# --- Django ---
ALLOWED_HOSTS=localhost,127.0.0.1,adapter-api
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- PostgreSQL ---
POSTGRES_DB=FSec_db
POSTGRES_USER=FSec_user
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://FSec_user:change-me-postgres-password@postgres_db:5432/FSec_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=FSec
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-clickhouse-password

# --- External Bank ---
EXTERNAL_BANK_URL=http://external_bank:8000
EXTERNAL_BANK_API_KEY=fsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_BEAT_INTERVAL=300

# --- JWT ---
JWT_ACCESS_TOKEN_HOURS=2
JWT_REFRESH_TOKEN_DAYS=7

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-password

# --- CORS (comma-separated origins for production) ---
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# --- Rate Limiting ---
THROTTLE_ANON_RATE=20/hour
THROTTLE_USER_RATE=1000/hour
THROTTLE_AUTH_RATE=10/minute
